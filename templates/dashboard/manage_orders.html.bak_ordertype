{% extends "dashboard/base_admin.html" %}
{% block admin_content %}
<style>
  .oh-head { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:18px; }
  .oh-head h2 { font-size:25px; color:#1a1a2e; margin:0; }
  .oh-head p { font-size:13px; color:#999; margin:3px 0 0; }
  .oh-actions { display:flex; gap:8px; }
  .btn { border:1.5px solid #e2e4ea; background:#fff; color:#1a1a2e; padding:9px 15px; border-radius:10px; font-size:13px; font-weight:700; cursor:pointer; transition:.15s; }
  .btn:hover { border-color:#1a1a2e; }
  .btn.live-on { border-color:#2ecc71; color:#1e9e55; background:#effcf4; }

  .oh-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
  .st { background:#fff; border-radius:14px; padding:14px 16px; display:flex; align-items:center; gap:12px; cursor:pointer;
        box-shadow:0 4px 14px rgba(0,0,0,.05); border:2px solid transparent; transition:.15s; }
  .st:hover { transform:translateY(-2px); }
  .st.on { border-color:#1a1a2e; }
  .st .ic { width:42px; height:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:21px; background:#eef2ff; }
  .st.amber .ic { background:#fff3cd; } .st.blue .ic { background:#e3f0ff; } .st.green .ic { background:#e3f9ec; }
  .st.red .ic { background:#fdecec; } .st.teal .ic { background:#e0f7f4; }
  .st b { display:block; font-size:21px; color:#1a1a2e; line-height:1.05; }
  .st span { font-size:11px; color:#8b8fa3; text-transform:uppercase; letter-spacing:.3px; }

  .oh-bar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:14px; }
  .search-box { flex:1; min-width:230px; position:relative; }
  .search-box input { width:100%; padding:11px 14px 11px 40px; border:1.5px solid #e6e6ee; border-radius:10px; font-size:14px; background:#fff; }
  .search-box input:focus { outline:none; border-color:#F63A3A; box-shadow:0 0 0 4px rgba(246,58,58,.08); }
  .search-box::before { content:"🔍"; position:absolute; left:14px; top:50%; transform:translateY(-50%); font-size:14px; opacity:.5; }
  .oh-bar select { padding:10px 12px; border:1.5px solid #e6e6ee; border-radius:10px; font-size:13px; font-weight:600; background:#fff; cursor:pointer; }
  .chips { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .filter-chip { padding:8px 14px; border-radius:20px; font-size:13px; font-weight:700; background:#f1f2f6; color:#666; cursor:pointer; border:1.5px solid transparent; transition:.15s; white-space:nowrap; }
  .filter-chip b { margin-left:5px; background:rgba(0,0,0,.08); padding:1px 7px; border-radius:10px; font-size:11.5px; }
  .filter-chip.active { background:#1a1a2e; color:#fff; } .filter-chip.active b { background:rgba(255,255,255,.2); }
  .filter-chip:hover:not(.active) { border-color:#ccc; }
  .shown { font-size:12.5px; color:#8b8fa3; margin-left:auto; align-self:center; }

  .oh-wrap { background:#fff; border-radius:16px; box-shadow:0 6px 20px rgba(0,0,0,.06); overflow:hidden; }
  table.orders-table { width:100%; border-collapse:collapse; }
  .orders-table thead th { background:#1a1a2e; color:#fff; text-align:left; padding:14px 14px; font-size:11.5px; text-transform:uppercase; letter-spacing:.5px; }
  .orders-table td { padding:13px 14px; border-top:1px solid #f0f1f5; font-size:14px; vertical-align:middle; color:#333; }
  .orders-table tbody tr { transition:background .15s; }
  .orders-table tbody tr:hover td { background:#fafbfd; }
  .orders-table tbody tr.needs-approval td { background:#fffbeb; }
  .orders-table tbody tr.needs-approval td:first-child { box-shadow:inset 4px 0 #f39c12; }
  .order-id { font-weight:800; color:#1a1a2e; font-size:15px; }
  .ago { display:block; font-size:11.5px; color:#9aa0b4; margin-top:2px; font-weight:500; }
  .needs-approval .ago { color:#b06a00; font-weight:700; }

  .cust { display:flex; align-items:center; gap:9px; }
  .av { width:32px; height:32px; border-radius:50%; background:#1a1a2e; color:#fff; font-weight:800; font-size:13px; display:flex; align-items:center; justify-content:center; flex:0 0 auto; }

  .items { display:flex; flex-direction:column; gap:7px; min-width:210px; }
  .it { display:flex; align-items:center; gap:9px; }
  .it img, .ph { width:40px; height:40px; border-radius:10px; object-fit:cover; flex:0 0 auto; background:#f3f4f8; }
  .ph { display:flex; align-items:center; justify-content:center; font-size:22px; }
  .it .q { font-weight:800; color:#F63A3A; font-size:13px; }
  .it .n { font-size:13px; color:#333; font-weight:600; line-height:1.2; }

  .amount { font-weight:800; color:#1a1a2e; white-space:nowrap; }
  .table-tag { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:12.5px; font-weight:700; background:#eef2ff; color:#4f46e5; white-space:nowrap; }
  .table-tag.takeaway { background:#f3f4f8; color:#888; }
  .table-assign { display:block; margin-top:6px; padding:4px 6px; border:1px solid #d9dce3; border-radius:8px; font-size:12px; background:#fff; }

  .pay-cell { display:flex; flex-direction:column; gap:6px; align-items:flex-start; }
  .pay-badge { padding:4px 11px; border-radius:16px; font-size:11.5px; font-weight:700; white-space:nowrap; }
  .pay-badge.online { background:#e3f0ff; color:#3498db; } .pay-badge.cash-pending { background:#fff3cd; color:#b06a00; }
  .pay-badge.paid { background:#e3f9ec; color:#1e9e55; } .pay-badge.unpaid { background:#f3f4f8; color:#888; }
  .pay-badge.refund-pending { background:#ffe5e5; color:#e74c3c; } .pay-badge.refunded { background:#e3f9ec; color:#1e9e55; }
  .cash-btn { padding:5px 11px; border-radius:8px; border:1.5px solid #2ecc71; background:#fff; color:#1e9e55; font-size:11.5px; font-weight:700; cursor:pointer; transition:.15s; }
  .cash-btn:hover { background:#2ecc71; color:#fff; } .cash-btn:disabled { opacity:.5; cursor:default; }
  .refund-btn { padding:5px 11px; border-radius:8px; border:1.5px solid #e74c3c; background:#fff; color:#e74c3c; font-size:11.5px; font-weight:700; cursor:pointer; transition:.15s; }
  .refund-btn:hover { background:#e74c3c; color:#fff; } .refund-btn:disabled { opacity:.5; cursor:default; }

  select.status-select { padding:7px 10px; border-radius:20px; border:1.5px solid transparent; font-size:12.5px; font-weight:800; cursor:pointer; }
  select.status-pending { background:#fff3cd; color:#b06a00; } select.status-confirmed { background:#fdecec; color:#F63A3A; }
  select.status-preparing { background:#e3f0ff; color:#3498db; } select.status-ready { background:#f3e5f9; color:#9b59b6; }
  select.status-delivered, select.status-completed { background:#e3f9ec; color:#1e9e55; } select.status-cancelled { background:#ffe5e5; color:#e74c3c; }

  .approve-cell { display:flex; flex-direction:column; gap:7px; align-items:flex-start; }
  .approve-label { font-size:11px; font-weight:800; color:#b06a00; text-transform:uppercase; letter-spacing:.4px; }
  .approve-actions { display:flex; gap:6px; flex-wrap:wrap; }
  .btn-approve, .btn-reject, .btn-stock { padding:7px 12px; border-radius:8px; border:0; font-size:12.5px; font-weight:800; cursor:pointer; transition:.15s; white-space:nowrap; }
  .btn-approve { background:#2ecc71; color:#fff; } .btn-approve:hover { background:#27ae60; }
  .btn-reject { background:#ffe5e5; color:#e74c3c; } .btn-reject:hover { background:#e74c3c; color:#fff; }
  .btn-stock { background:#e3f0ff; color:#3498db; } .btn-stock:hover { background:#3498db; color:#fff; }
  .approve-actions button:disabled { opacity:.5; cursor:default; }
  .await-pay { font-size:12px; font-weight:700; color:#888; background:#f3f4f8; padding:6px 12px; border-radius:16px; white-space:nowrap; }

  .empty-state { display:none; text-align:center; padding:50px 20px; color:#aaa; }
  .empty-state.show { display:block; } .empty-state .big { font-size:42px; }

  .stock-overlay { position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:9999; display:flex; align-items:center; justify-content:center; padding:16px; }
  .stock-modal { background:#fff; border-radius:16px; padding:22px 24px; width:100%; max-width:500px; max-height:82vh; overflow-y:auto; box-shadow:0 20px 50px rgba(0,0,0,.25); }
  .stock-modal h3 { font-size:18px; color:#1a1a2e; margin:0 0 4px; }
  .stock-modal h4 { font-size:12px; color:#999; text-transform:uppercase; letter-spacing:.4px; margin:16px 0 8px; }
  .stock-modal ul { list-style:none; padding:0; margin:0; }
  .stock-modal li { padding:7px 0; border-bottom:1px solid #f2f2f5; font-size:14px; }
  .stock-modal li.bad { color:#e74c3c; font-weight:700; }
  .stock-modal .today-note { font-size:12px; color:#3498db; font-weight:600; margin-top:2px; }
  .stock-modal table { width:100%; border-collapse:collapse; font-size:13.5px; }
  .stock-modal td { padding:7px 4px; border-bottom:1px solid #f2f2f5; }
  .stock-modal tr.low td { color:#e74c3c; font-weight:700; }
  .stock-modal .stock-note { font-size:12px; color:#999; margin-top:12px; }
  .stock-close { margin-top:16px; padding:9px 18px; border:0; border-radius:8px; background:#1a1a2e; color:#fff; font-weight:700; cursor:pointer; }

  .rj-chips { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:10px; }
  .rj-chip { padding:6px 12px; border-radius:16px; background:#f1f2f6; font-size:12.5px; font-weight:700; color:#555; cursor:pointer; }
  .rj-chip:hover { background:#ffe5e5; color:#e74c3c; }
  .rj-text { width:100%; padding:10px 12px; border:1.5px solid #e6e6ee; border-radius:10px; font-size:14px; font-family:inherit; resize:vertical; }
  .rj-text:focus { outline:none; border-color:#e74c3c; }
  .rj-go { margin-top:14px; padding:9px 18px; border:0; border-radius:8px; background:#e74c3c; color:#fff; font-weight:800; cursor:pointer; }
  .stock-close.light { background:#f1f2f6; color:#555; margin-left:6px; }
  #toasts { position:fixed; right:18px; bottom:18px; z-index:10000; display:flex; flex-direction:column; gap:8px; }
  .toast { background:#1a1a2e; color:#fff; padding:11px 16px; border-radius:10px; font-size:13.5px; font-weight:600; box-shadow:0 8px 24px rgba(0,0,0,.25); animation:tIn .25s ease; }
  .toast.err { background:#e74c3c; }
  @keyframes tIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
  @media (max-width:760px) { .oh-wrap { overflow-x:auto; } table.orders-table { min-width:1000px; } .shown { margin-left:0; } }
</style>

<div class="oh-head">
  <div>
    <h2>🧾 Orders</h2>
    <p>Approve new orders, collect cash and track every order in one place</p>
  </div>
  <div class="oh-actions">
    <button type="button" class="btn live-on" id="liveBtn" onclick="toggleLive()">🟢 Live</button>
    <button type="button" class="btn" onclick="exportCsv()">⬇️ Export CSV</button>
  </div>
</div>

<div class="oh-stats">
  <div class="st" data-f="all" onclick="setFilter('all')"><div class="ic">📦</div><div><b id="sTotal">0</b><span>Total orders</span></div></div>
  <div class="st amber" data-f="approval" onclick="setFilter('approval')"><div class="ic">⏳</div><div><b id="sApproval">0</b><span>Need approval</span></div></div>
  <div class="st blue" data-f="kitchen" onclick="setFilter('kitchen')"><div class="ic">👨‍🍳</div><div><b id="sKitchen">0</b><span>In kitchen</span></div></div>
  <div class="st green" data-f="delivered" onclick="setFilter('delivered')"><div class="ic">✅</div><div><b id="sDelivered">0</b><span>Delivered</span></div></div>
  <div class="st teal"><div class="ic">💰</div><div><b id="sSales">₹0</b><span>Today's sales</span></div></div>
  <div class="st red" onclick="setPay('cashpending')"><div class="ic">💵</div><div><b id="sCash">₹0</b><span>Cash to collect</span></div></div>
  <div class="st red" onclick="setPay('refundpending')"><div class="ic">💸</div><div><b id="sRefund">₹0</b><span>Refunds to pay</span></div></div>
</div>

<div class="oh-bar">
  <div class="search-box"><input type="text" id="orderSearch" placeholder="Search order ID, customer or dish...  ( / )" autocomplete="off"></div>
  <select id="payFilter" autocomplete="off">
    <option value="all">All payments</option>
    <option value="cashpending">💵 Cash pending</option>
    <option value="cashpaid">💵 Cash paid</option>
    <option value="online">💳 Paid online</option>
    <option value="refundpending">💸 Refund pending</option>
    <option value="refunded">↩️ Refunded</option>
    <option value="unpaid">⏳ Unpaid</option>
  </select>
  <select id="sortBy" autocomplete="off">
    <option value="attention">⚡ Needs attention first</option>
    <option value="newest">🕒 Newest first</option>
    <option value="oldest">🕰️ Oldest first</option>
    <option value="amount">💰 Highest amount</option>
  </select>
</div>

<div class="chips">
  <div class="filter-chip active" data-filter="all" onclick="setFilter('all')">All<b>0</b></div>
  <div class="filter-chip" data-filter="approval" onclick="setFilter('approval')">Approval<b>0</b></div>
  <div class="filter-chip" data-filter="pending" onclick="setFilter('pending')">Pending<b>0</b></div>
  <div class="filter-chip" data-filter="kitchen" onclick="setFilter('kitchen')">In kitchen<b>0</b></div>
  <div class="filter-chip" data-filter="delivered" onclick="setFilter('delivered')">Delivered<b>0</b></div>
  <div class="filter-chip" data-filter="cancelled" onclick="setFilter('cancelled')">Cancelled<b>0</b></div>
  <span class="shown" id="shownCount"></span>
</div>

<div class="oh-wrap">
  <table class="orders-table">
    <thead>
      <tr><th>Order</th><th>Customer</th><th>Table</th><th>Items</th><th>Amount</th><th>Payment</th><th>Status</th><th>Placed On</th></tr>
    </thead>
    <tbody id="ordersTableBody">
      {% for order in orders %}
      {% with cname=order.user.get_full_name|default:order.user.username %}
      <tr data-id="{{ order.id }}" data-status="{{ order.status|lower }}"
          data-approval="{% if order.status == 'pending' and order.payment_status != 'pending' %}1{% else %}0{% endif %}"
          data-pay="{% if order.payment_status == 'pending' %}unpaid{% elif order.payment_method == 'cash' %}{% if order.payment_status == 'paid' %}cashpaid{% else %}cashpending{% endif %}{% elif order.status == 'cancelled' and order.payment_status == 'paid' %}{% if order.refunded %}refunded{% else %}refundpending{% endif %}{% else %}online{% endif %}"
          data-amount="{{ order.total_amount|stringformat:'s' }}"
          data-ts="{{ order.created_at|date:'U' }}"
          data-day="{{ order.created_at|date:'Y-m-d' }}"
          data-date="{{ order.created_at|date:'d M Y H:i' }}"
          data-cust="{{ cname }}"
          class="{% if order.status == 'pending' and order.payment_status != 'pending' %}needs-approval{% endif %}"
          data-search="{{ order.id }} {{ cname|lower }} {% for item in order.items.all %}{{ item.food_item.name|lower }} {% endfor %}">
        <td><span class="order-id">#{{ order.id }}</span></td>
        <td><div class="cust"><span class="av">{{ cname|slice:":1"|upper }}</span>{{ cname }}</div></td>
        <td>
          {% if order.table %}
            <span class="table-tag" id="tableTag{{ order.id }}">🪑 #{{ order.table.number }}</span>
          {% else %}
            <span class="table-tag takeaway" id="tableTag{{ order.id }}">🥡 Takeaway</span>
          {% endif %}
          {% if order.status != 'delivered' and order.status != 'cancelled' %}
          <select class="table-assign" autocomplete="off" onchange="assignTable(this, {{ order.id }})" title="Assign table">
            <option value="" {% if not order.table %}selected{% endif %}>Assign table…</option>
            {% if order.table %}<option value="{{ order.table.id }}" selected>Table #{{ order.table.number }}</option>{% endif %}
            {% for t in free_tables %}{% if t.id != order.table_id %}<option value="{{ t.id }}">Table #{{ t.number }}</option>{% endif %}{% endfor %}
          </select>
          {% endif %}
        </td>
        <td>
          <div class="items">
            {% for item in order.items.all %}
            <div class="it">
              {% if item.food_item.image %}<img src="{{ item.food_item.image.url }}" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"><span class="ph" style="display:none" data-n="{{ item.food_item.name }}"></span>{% else %}<span class="ph" data-n="{{ item.food_item.name }}"></span>{% endif %}
              <span class="q">{{ item.quantity }}×</span><span class="n">{{ item.food_item.name }}</span>
            </div>
            {% endfor %}
          </div>
        </td>
        <td class="amount">₹{{ order.total_amount }}</td>
        <td>
          <div class="pay-cell">
            {% if order.payment_status == 'pending' %}
              <span class="pay-badge unpaid" id="payBadge{{ order.id }}">⏳ Payment Pending</span>
            {% elif order.payment_method == 'cash' %}
              {% if order.payment_status == 'paid' %}
                <span class="pay-badge paid" id="payBadge{{ order.id }}">💵 Cash Paid</span>
              {% else %}
                <span class="pay-badge cash-pending" id="payBadge{{ order.id }}">💵 Cash Pending</span>
                <button class="cash-btn" id="cashBtn{{ order.id }}" onclick="markCashReceived({{ order.id }})">Mark Received</button>
              {% endif %}
            {% elif order.status == 'cancelled' and order.payment_status == 'paid' %}
              {% if order.refunded %}
                <span class="pay-badge refunded" id="payBadge{{ order.id }}">↩️ Refunded</span>
              {% else %}
                <span class="pay-badge refund-pending" id="payBadge{{ order.id }}">💸 Refund pending</span>
                <button class="refund-btn" id="refundBtn{{ order.id }}" onclick="markRefunded({{ order.id }})">Mark Refunded</button>
              {% endif %}
            {% else %}
              <span class="pay-badge online" id="payBadge{{ order.id }}">💳 Paid Online</span>
            {% endif %}
          </div>
        </td>
        <td>
          {% if order.status == 'pending' and order.payment_status != 'pending' %}
            <div class="approve-cell">
              <span class="approve-label">Waiting for approval</span>
              <div class="approve-actions">
                <button class="btn-stock" onclick="checkStock({{ order.id }})">📦 Check Stock</button>
                <button class="btn-approve" onclick="decideOrder(this, {{ order.id }}, 'approve')">✅ Approve</button>
                <button class="btn-reject" onclick="openReject(this, {{ order.id }})">❌ Reject</button>
              </div>
            </div>
          {% elif order.status == 'pending' %}
            <span class="await-pay">⏳ Awaiting payment</span>
          {% else %}
            <select class="status-select status-{{ order.status|lower }}" autocomplete="off" onchange="updateStatus(this, {{ order.id }})">
              <option value="pending" {% if order.status|lower == "pending" %}selected{% endif %}>⏳ Pending</option>
              <option value="confirmed" {% if order.status|lower == "confirmed" %}selected{% endif %}>🧾 Confirmed</option>
              <option value="preparing" {% if order.status|lower == "preparing" %}selected{% endif %}>👨‍🍳 Preparing</option>
              <option value="ready" {% if order.status|lower == "ready" %}selected{% endif %}>🔔 Ready</option>
              <option value="delivered" {% if order.status|lower == "delivered" %}selected{% endif %}>✅ Delivered</option>
              <option value="cancelled" {% if order.status|lower == "cancelled" %}selected{% endif %}>❌ Cancelled</option>
            </select>
          {% endif %}
        </td>
        <td>{{ order.created_at|date:"d M Y, g:i A" }}<span class="ago">{{ order.created_at|timesince }} ago</span></td>
      </tr>
      {% endwith %}
      {% endfor %}
    </tbody>
  </table>
  <div class="empty-state" id="emptyState"><div class="big">🧾</div><p>No orders match your filters.</p></div>
</div>

<div id="toasts"></div>

<script>
  const tbody = document.getElementById('ordersTableBody');
  const searchInput = document.getElementById('orderSearch');
  const KITCHEN = ['confirmed', 'preparing', 'ready'];
  const PAID = ['confirmed', 'preparing', 'ready', 'delivered'];
  let currentFilter = 'all', payFilter = 'all', sortBy = 'attention', live = true;

  const getRows = () => Array.from(tbody.querySelectorAll('tr[data-status]'));
  const money = n => '₹' + Math.round(n).toLocaleString('en-IN');
  const setText = (id, v) => { document.getElementById(id).textContent = v; };
  function todayStr() {
    const d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  function getCsrfToken() { return document.cookie.match(/csrftoken=([^;]+)/)?.[1] || ''; }
  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function toast(msg, err) {
    const t = document.createElement('div');
    t.className = 'toast' + (err ? ' err' : '');
    t.textContent = msg;
    document.getElementById('toasts').appendChild(t);
    setTimeout(() => t.remove(), 3200);
  }

  /* ---- dish icons when there is no photo ---- */
  const ICONS = [
    [/mojito|juice|crush|shake|soda|drink|lassi|tea|coffee|lime/i, '🍹'],
    [/fish|meen|nethili|prawn|crab|sura/i, '🐟'],
    [/biryani|biriyani|rice|pulao/i, '🍛'],
    [/chicken|65|tikka|kebab|wings|lollipop/i, '🍗'],
    [/mutton|kari|lamb|beef|keema|chops/i, '🍖'],
    [/paneer|veg|mushroom|gobi|aloo/i, '🥘'],
    [/egg|omelette/i, '🥚'],
    [/apple|mango|berry|strawberr|fruit|banana/i, '🍎'],
    [/ice|cake|sweet|dessert|halwa|kulfi/i, '🍨'],
    [/parotta|naan|roti|bread|dosa|chapati/i, '🫓'],
    [/soup/i, '🍲']
  ];
  function fillPh(root) {
    root.querySelectorAll('.ph').forEach(el => {
      if (el.textContent) return;
      const n = el.dataset.n || '';
      const m = ICONS.find(i => i[0].test(n));
      el.textContent = m ? m[1] : '🍽️';
    });
  }

  /* ---- filters / stats / sort ---- */
  function inFilter(r, f) {
    const s = r.dataset.status;
    if (f === 'all') return true;
    if (f === 'approval') return r.dataset.approval === '1';
    if (f === 'kitchen') return KITCHEN.includes(s);
    if (f === 'delivered') return s === 'delivered' || s === 'completed';
    return s === f;
  }
  function stats() {
    const rs = getRows(), t = todayStr();
    let sales = 0, cash = 0, refund = 0;
    rs.forEach(r => {
      const amt = parseFloat(r.dataset.amount) || 0;
      if (r.dataset.day === t && PAID.includes(r.dataset.status)) sales += amt;
      if (r.dataset.pay === 'cashpending' && r.dataset.status !== 'cancelled') cash += amt;
      if (r.dataset.pay === 'refundpending') refund += amt;
    });
    const c = f => rs.filter(r => inFilter(r, f)).length;
    setText('sTotal', rs.length); setText('sApproval', c('approval'));
    setText('sKitchen', c('kitchen')); setText('sDelivered', c('delivered'));
    setText('sSales', money(sales)); setText('sCash', money(cash)); setText('sRefund', money(refund));
    document.querySelectorAll('.filter-chip').forEach(ch => { ch.querySelector('b').textContent = c(ch.dataset.filter); });
  }
  function sortRows() {
    const rs = getRows();
    rs.sort((a, b) => {
      if (sortBy === 'attention') { const d = (b.dataset.approval | 0) - (a.dataset.approval | 0); if (d) return d; }
      if (sortBy === 'oldest') return a.dataset.ts - b.dataset.ts;
      if (sortBy === 'amount') return parseFloat(b.dataset.amount) - parseFloat(a.dataset.amount);
      return b.dataset.ts - a.dataset.ts;
    });
    rs.forEach(r => tbody.appendChild(r));
  }
  function applyFilters() {
    const q = searchInput.value.trim().replace(/^#/, '').toLowerCase();
    let shown = 0;
    getRows().forEach(r => {
      const ok = r.dataset.search.includes(q) && inFilter(r, currentFilter) && (payFilter === 'all' || r.dataset.pay === payFilter);
      r.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    document.getElementById('emptyState').classList.toggle('show', shown === 0);
    setText('shownCount', shown + ' / ' + getRows().length + ' orders');
    document.querySelectorAll('.filter-chip').forEach(c => c.classList.toggle('active', c.dataset.filter === currentFilter));
    document.querySelectorAll('.st[data-f]').forEach(c => c.classList.toggle('on', c.dataset.f === currentFilter && currentFilter !== 'all'));
  }
  function refreshView() { sortRows(); stats(); applyFilters(); }
  function setFilter(f) { currentFilter = f; applyFilters(); }
  function setPay(p) { payFilter = payFilter === p ? 'all' : p; document.getElementById('payFilter').value = payFilter; applyFilters(); }

  searchInput.addEventListener('input', applyFilters);
  document.getElementById('payFilter').addEventListener('change', e => { payFilter = e.target.value; applyFilters(); });
  document.getElementById('sortBy').addEventListener('change', e => { sortBy = e.target.value; refreshView(); });
  document.addEventListener('keydown', e => {
    const tag = (e.target.tagName || '').toLowerCase();
    if (e.key === '/' && tag !== 'input' && tag !== 'textarea' && tag !== 'select') { e.preventDefault(); searchInput.focus(); }
  });

  /* ---- update one row without reloading ---- */
  function setRowStatus(row, status) {
    row.dataset.status = status;
    if (status !== 'pending') { row.dataset.approval = '0'; row.classList.remove('needs-approval'); }
    const sel = row.querySelector('.status-select');
    if (sel) { sel.value = status; sel.className = 'status-select status-' + status; }
    if (status === 'delivered' || status === 'cancelled') { const ta = row.querySelector('.table-assign'); if (ta) ta.remove(); }
    stats(); applyFilters();
  }

  function updateStatus(select, orderId) {
    const row = select.closest('tr'), prev = row.dataset.status;
    select.className = 'status-select status-' + select.value;
    fetch(`/dashboard/orders/${orderId}/update-status/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRFToken': getCsrfToken() },
      body: JSON.stringify({ status: select.value })
    })
      .then(res => res.json())
      .then(d => {
        if (!d.ok) throw new Error('fail');
        setRowStatus(row, d.status);
        toast('Order #' + orderId + ' → ' + d.status);
        // cancelled / un-cancelled online-paid order: reload so the refund badge is correct
        if (d.status === 'cancelled' || prev === 'cancelled') setTimeout(() => location.reload(), 700);
      })
      .catch(() => {
        select.value = prev; select.className = 'status-select status-' + prev;
        toast('Could not update status. Try again.', true);
      });
  }

  function markCashReceived(orderId) {
    const btn = document.getElementById('cashBtn' + orderId);
    const badge = document.getElementById('payBadge' + orderId);
    const row = badge.closest('tr');
    if (btn) { btn.disabled = true; btn.textContent = 'Updating...'; }
    fetch(`/dashboard/orders/${orderId}/mark-cash-received/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRFToken': getCsrfToken() }
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) throw new Error('fail');
        badge.className = 'pay-badge paid';
        badge.textContent = '💵 Cash Paid';
        if (btn) btn.remove();
        row.dataset.pay = 'cashpaid';
        if (data.status) setRowStatus(row, data.status); else { stats(); applyFilters(); }
        toast(data.status === 'delivered' ? 'Cash received. Order #' + orderId + ' delivered ✅' : 'Cash received for order #' + orderId);
      })
      .catch(() => {
        if (btn) { btn.disabled = false; btn.textContent = 'Mark Received'; }
        toast('Could not update. Try again.', true);
      });
  }

  function markRefunded(orderId) {
    const btn = document.getElementById('refundBtn' + orderId);
    const badge = document.getElementById('payBadge' + orderId);
    const row = badge.closest('tr');
    if (!confirm('Order #' + orderId + ' க்கு பணம் திருப்பிக் கொடுத்துட்டீங்களா?')) return;
    if (btn) { btn.disabled = true; btn.textContent = 'Updating...'; }
    fetch(`/dashboard/orders/${orderId}/mark-refunded/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRFToken': getCsrfToken() }
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) throw new Error('fail');
        badge.className = 'pay-badge refunded';
        badge.textContent = '↩️ Refunded';
        if (btn) btn.remove();
        row.dataset.pay = 'refunded';
        stats(); applyFilters();
        toast('Order #' + orderId + ' refunded ✅');
      })
      .catch(() => {
        if (btn) { btn.disabled = false; btn.textContent = 'Mark Refunded'; }
        toast('Could not update. Try again.', true);
      });
  }

  function assignTable(select, orderId) {
    const prev = select.dataset.prev ?? (select.querySelector('option[selected]')?.value || '');
    const body = new URLSearchParams({ table: select.value });
    fetch(`/dashboard/orders/${orderId}/assign-table/`, { method: 'POST', headers: { 'X-CSRFToken': getCsrfToken() }, body })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          const tag = document.getElementById('tableTag' + orderId);
          if (data.table) { tag.className = 'table-tag'; tag.textContent = '🪑 #' + data.table; }
          else { tag.className = 'table-tag takeaway'; tag.textContent = '🥡 Takeaway'; }
          select.dataset.prev = select.value;
        } else {
          alert(data.error || 'Could not assign table.');
          select.value = prev;
        }
      })
      .catch(() => { alert('Could not assign table. Try again.'); select.value = prev; });
  }

  /* ---- stock check + approve / reject ---- */
  function checkStock(orderId) {
    fetch(`/dashboard/orders/${orderId}/stock-check/`)
      .then(res => { if (!res.ok) throw new Error('bad response'); return res.json(); })
      .then(d => {
        const itemsHtml = d.items.map(i =>
          `<li class="${i.available ? '' : 'bad'}">${i.qty}× ${esc(i.name)} ${i.available ? '✅' : '❌ Unavailable'}
             <div class="today-note">Today: ${i.today_qty} plate(s) ordered by ${i.today_orders} order(s)</div></li>`
        ).join('') || '<li>No items</li>';
        const reqHtml = (d.requirements || []).map(r =>
          `<tr class="${r.short ? 'low' : ''}"><td>${esc(r.name)}</td><td>Need ${r.need} ${esc(r.unit)}</td><td>Have ${r.have} ${esc(r.unit)}</td><td>${r.short ? '❌ Short' : '✅ OK'}</td></tr>`
        ).join('') || '<tr><td>No recipe set for these items</td></tr>';
        const noRecipeHtml = (d.no_recipe && d.no_recipe.length) ? `<p class="stock-note">⚠ No recipe for: ${d.no_recipe.map(esc).join(', ')}</p>` : '';
        const demandHtml = (d.today_demand || []).map(t =>
          `<tr><td>${esc(t.name)}</td><td>${t.qty} plate(s)</td><td>${t.orders} order(s)</td></tr>`
        ).join('') || '<tr><td>No orders today</td></tr>';
        const grocHtml = d.groceries.map(g =>
          `<tr class="${g.low ? 'low' : ''}"><td>${esc(g.name)}</td><td>${g.qty} ${esc(g.unit)}</td><td>${g.low ? '⚠ Low' : 'OK'}</td></tr>`
        ).join('') || '<tr><td>No grocery items</td></tr>';

        const overlay = document.createElement('div');
        overlay.className = 'stock-overlay';
        overlay.innerHTML = `
          <div class="stock-modal">
            <h3>📦 Order #${d.order_id} - Stock Check</h3>
            <h4>Items in this order</h4><ul>${itemsHtml}</ul>
            <h4>This order needs (from recipes)</h4><table>${reqHtml}</table>${noRecipeHtml}
            <h4>Today's demand (all items)</h4><table>${demandHtml}</table>
            <h4>Kitchen grocery stock</h4><table>${grocHtml}</table>
            <p class="stock-note">Stock is checked before approving. Close this and choose Approve or Reject.</p>
            <button class="stock-close">Close</button>
          </div>`;
        overlay.addEventListener('click', e => {
          if (e.target === overlay || e.target.classList.contains('stock-close')) overlay.remove();
        });
        document.body.appendChild(overlay);
      })
      .catch(() => toast('Could not load stock. Try again.', true));
  }

  const REASONS = ['Out of stock', 'Dish not available', 'Kitchen is closed', 'Too busy right now'];
  function openReject(btn, orderId) {
    const row = btn.closest('tr');
    const dishes = Array.from(row.querySelectorAll('.it .n')).map(n => n.textContent).join(', ');
    const online = row.dataset.pay === 'online';
    const ov = document.createElement('div');
    ov.className = 'stock-overlay';
    ov.innerHTML = `
      <div class="stock-modal">
        <h3>❌ Reject order #${orderId}</h3>
        <p class="stock-note" style="margin:4px 0 0">${esc(dishes)}</p>
        <h4>Why? The customer will be told this</h4>
        <div class="rj-chips">${REASONS.map(r => `<span class="rj-chip">${r}</span>`).join('')}</div>
        <textarea class="rj-text" rows="2" maxlength="200" placeholder="Reason (optional)"></textarea>
        ${online ? '<p class="stock-note">💳 Paid online. The customer will be told a refund is coming. It will show as "Refund pending" here until you press Mark Refunded.</p>' : ''}
        <button class="rj-go">Reject order</button><button class="stock-close light">Cancel</button>
      </div>`;
    const ta = ov.querySelector('.rj-text');
    ov.addEventListener('click', e => {
      if (e.target === ov || e.target.classList.contains('stock-close')) ov.remove();
      else if (e.target.classList.contains('rj-chip')) ta.value = e.target.textContent;
      else if (e.target.classList.contains('rj-go')) { const reason = ta.value.trim(); ov.remove(); decideOrder(btn, orderId, 'reject', false, reason); }
    });
    document.body.appendChild(ov);
    ta.focus();
  }

  function decideOrder(btn, orderId, action, force, reason) {
    const box = btn.closest('.approve-actions');
    box.querySelectorAll('button').forEach(b => b.disabled = true);
    const body = new URLSearchParams();
    if (force) body.set('force', '1');
    if (reason) body.set('reason', reason);
    fetch(`/dashboard/orders/${orderId}/${action}/`, { method: 'POST', headers: { 'X-CSRFToken': getCsrfToken() }, body })
      .then(res => res.json())
      .then(data => {
        if (data.ok) { location.reload(); return; }
        box.querySelectorAll('button').forEach(b => b.disabled = false);
        if (data.short && action === 'approve') {
          if (confirm(data.error + '\n\nApprove anyway?')) decideOrder(btn, orderId, action, true);
        } else {
          alert(data.error || 'Could not update the order.');
        }
      })
      .catch(() => { alert('Could not update the order. Try again.'); box.querySelectorAll('button').forEach(b => b.disabled = false); });
  }

  /* ---- live refresh + CSV ---- */
  function toggleLive() {
    live = !live;
    const b = document.getElementById('liveBtn');
    b.textContent = live ? '🟢 Live' : '⏸️ Paused';
    b.classList.toggle('live-on', live);
  }
  async function liveRefresh() {
    if (!live || document.hidden || document.querySelector('.stock-overlay')) return;
    const ae = document.activeElement;
    if (ae && ae.tagName === 'SELECT') return;
    try {
      const r = await fetch(location.pathname, { credentials: 'same-origin' });
      if (!r.ok) return;
      const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
      const nb = doc.getElementById('ordersTableBody');
      if (!nb) return;
      tbody.innerHTML = nb.innerHTML;
      fillPh(tbody); refreshView();
    } catch (e) {}
  }
  setInterval(liveRefresh, 20000);

  function exportCsv() {
    const q = s => '"' + String(s).replace(/"/g, '""') + '"';
    const lines = [['Order', 'Customer', 'Table', 'Items', 'Amount', 'Payment', 'Status', 'Placed'].map(q).join(',')];
    getRows().filter(r => r.style.display !== 'none').forEach(r => {
      const items = Array.from(r.querySelectorAll('.it')).map(i => i.querySelector('.q').textContent + ' ' + i.querySelector('.n').textContent).join('; ');
      lines.push([r.dataset.id, r.dataset.cust, r.querySelector('.table-tag').textContent.trim(), items,
                  r.dataset.amount, r.dataset.pay, r.dataset.status, r.dataset.date].map(q).join(','));
    });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv' }));
    a.download = 'orders_' + todayStr() + '.csv';
    a.click();
    toast('CSV downloaded');
  }

  fillPh(document);
  refreshView();
</script>
{% endblock %}s