{% extends "dashboard/base_admin.html" %}
{% comment %}
  Manage Grocery - redesigned.
  Things to match with your project (search for "ADJUST"):
    1. block name below (content)
    2. url names: grocery_add, grocery_update, grocery_delete
    3. context variable: items (each item: id, name, quantity, unit, alert_limit)
    4. POST field names: name, quantity, unit, alert_limit
  Stats, status, filters, search, sort, CSV export are all computed in the browser,
  so no extra context variables are needed.
{% endcomment %}

{% block content %} {# ADJUST: block name #}
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@500;600;700&display=swap');

.gs {
  --ink: #0f2a2e;
  --muted: #5d7377;
  --line: #dce6e4;
  --page: #f4f7f6;
  --card: #ffffff;
  --teal: #0e7c7b;
  --teal-soft: #e0f2f0;
  --gold: #e9a820;
  --gold-soft: #fdf1d3;
  --coral: #e5484d;
  --coral-soft: #fde6e6;
  font-family: 'Inter', system-ui, sans-serif;
  color: var(--ink);
  padding: 8px 4px 80px;
}
.gs * { box-sizing: border-box; }
.gs h1, .gs h2, .gs .num { font-family: 'Sora', 'Inter', sans-serif; }

/* header */
.gs-head { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; justify-content: space-between; margin-bottom: 22px; }
.gs-head h1 { font-size: 1.9rem; font-weight: 700; margin: 0 0 4px; letter-spacing: -0.02em; }
.gs-head p { margin: 0; color: var(--muted); font-size: .92rem; max-width: 56ch; }
.gs-actions { display: flex; gap: 8px; flex-wrap: wrap; }

.gs-btn { border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 10px; padding: 9px 14px; font: 500 .86rem 'Inter', sans-serif; cursor: pointer; transition: background .15s, border-color .15s, transform .1s; }
.gs-btn:hover { border-color: var(--teal); background: var(--teal-soft); }
.gs-btn:active { transform: scale(.97); }
.gs-btn.primary { background: var(--teal); border-color: var(--teal); color: #fff; }
.gs-btn.primary:hover { background: #0a6564; }
.gs :focus-visible { outline: 3px solid rgba(14,124,123,.45); outline-offset: 2px; }

/* overview: one segmented bar */
.gs-overview { background: var(--ink); color: #fff; border-radius: 18px; padding: 22px 24px; margin-bottom: 18px; }
.gs-ov-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px; margin-bottom: 16px; }
.gs-ov-total { font-size: 2.4rem; font-weight: 700; line-height: 1; }
.gs-ov-label { color: #9fc2c0; font-size: .92rem; }
.gs-seg { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: rgba(255,255,255,.12); }
.gs-seg span { display: block; height: 100%; transition: width .5s cubic-bezier(.2,.8,.2,1); }
.gs-seg .s-ok { background: #3ec9a7; }
.gs-seg .s-low { background: var(--gold); }
.gs-seg .s-out { background: var(--coral); }
.gs-legend { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
.gs-legend button { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,.08); border: 1px solid transparent; color: #fff; border-radius: 999px; padding: 7px 14px; font: 500 .85rem 'Inter', sans-serif; cursor: pointer; transition: background .15s; }
.gs-legend button:hover { background: rgba(255,255,255,.16); }
.gs-legend button.active { border-color: #fff; background: rgba(255,255,255,.18); }
.gs-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
.gs-dot.ok { background: #3ec9a7; } .gs-dot.low { background: var(--gold); } .gs-dot.out { background: var(--coral); } .gs-dot.all { background: #fff; }
.gs-legend b { font-family: 'Sora', sans-serif; }

/* add panel */
.gs-add { background: var(--card); border: 1px solid var(--line); border-radius: 16px; margin-bottom: 18px; overflow: hidden; }
.gs-add-toggle { width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: 0; padding: 16px 20px; font: 600 1rem 'Sora', sans-serif; color: var(--ink); cursor: pointer; }
.gs-add-toggle .chev { transition: transform .2s; color: var(--muted); }
.gs-add.open .chev { transform: rotate(180deg); }
.gs-add-body { display: none; padding: 0 20px 20px; }
.gs-add.open .gs-add-body { display: block; }
.gs-add-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 12px; align-items: end; }
.gs label { display: block; font-size: .78rem; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
.gs .gs-field { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font: 400 .92rem 'Inter', sans-serif; background: #fbfdfc; color: var(--ink); }
.gs .gs-field:focus { border-color: var(--teal); outline: 3px solid rgba(14,124,123,.18); background: #fff; }

/* list */
.gs-list { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px 8px; }
.gs-tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
.gs-search { position: relative; flex: 1 1 260px; }
.gs-search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); }
.gs-search input { padding-left: 38px; }
.gs-count { color: var(--muted); font-size: .82rem; margin-left: auto; }

.gs-row { display: grid; grid-template-columns: minmax(150px, 1.3fr) minmax(220px, 2fr) 90px 100px 250px 44px; gap: 16px; align-items: center; padding: 16px 4px; border-top: 1px solid var(--line); }
.gs-row.head { border-top: 0; padding: 4px 4px 10px; font-size: .74rem; font-weight: 600; color: var(--muted); }
.gs-row.low { background: linear-gradient(90deg, var(--gold-soft), transparent 55%); }
.gs-row.out { background: linear-gradient(90deg, var(--coral-soft), transparent 55%); }
.gs-name { font-weight: 600; font-size: .98rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; text-transform: capitalize; }
.gs-dup { font-size: .7rem; font-weight: 600; background: var(--gold-soft); color: #8a5d00; border-radius: 6px; padding: 2px 7px; text-transform: none; }

/* gauge: the signature element. The tick marks the alert limit. */
.gs-gauge-qty { font-family: 'Sora', sans-serif; font-weight: 600; font-size: 1.05rem; margin-bottom: 7px; }
.gs-gauge-qty small { font-family: 'Inter', sans-serif; font-weight: 500; color: var(--muted); font-size: .8rem; }
.gs-track { position: relative; height: 10px; border-radius: 999px; background: #e8efee; }
.gs-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: var(--teal); transition: width .5s cubic-bezier(.2,.8,.2,1), background .2s; }
.gs-row.low .gs-fill { background: var(--gold); }
.gs-row.out .gs-fill { background: var(--coral); }
.gs-tick { position: absolute; left: 33.333%; top: -4px; bottom: -4px; width: 2px; background: var(--ink); border-radius: 2px; opacity: .55; }

.gs-limit { color: var(--muted); font-size: .9rem; }
.gs-pill { display: inline-block; font-size: .76rem; font-weight: 600; border-radius: 999px; padding: 4px 11px; }
.gs-row .gs-pill { background: var(--teal-soft); color: #0a5958; }
.gs-row.low .gs-pill { background: #fbe3a6; color: #7a5200; }
.gs-row.out .gs-pill { background: #f9c9cb; color: #a8262b; }

.gs-edit { display: flex; align-items: center; gap: 6px; }
.gs-step { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fbfdfc; }
.gs-step button { border: 0; background: none; width: 32px; height: 36px; font-size: 1.1rem; cursor: pointer; color: var(--ink); }
.gs-step button:hover { background: var(--teal-soft); }
.gs-step input { width: 74px; border: 0; background: transparent; text-align: center; font: 500 .9rem 'Inter', sans-serif; padding: 0; -moz-appearance: textfield; }
.gs-step input::-webkit-outer-spin-button, .gs-step input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.gs-step input:focus { outline: none; }
.gs-save { border: 0; border-radius: 10px; height: 38px; padding: 0 14px; font: 600 .84rem 'Inter', sans-serif; background: #e8efee; color: #8aa0a3; cursor: not-allowed; transition: background .2s, color .2s; }
.gs-row.dirty .gs-save { background: var(--teal); color: #fff; cursor: pointer; }
.gs-row.dirty .gs-step { border-color: var(--teal); }

.gs-del { border: 0; background: none; width: 36px; height: 36px; border-radius: 10px; cursor: pointer; color: var(--muted); }
.gs-del:hover { background: var(--coral-soft); color: var(--coral); }

.gs-empty { text-align: center; padding: 48px 12px; color: var(--muted); display: none; }
.gs-empty.show { display: block; }
.gs-empty strong { display: block; font-family: 'Sora', sans-serif; color: var(--ink); font-size: 1.05rem; margin-bottom: 4px; }

/* dialog + toast */
.gs-dialog { border: 0; border-radius: 16px; padding: 24px; max-width: 380px; width: 92%; box-shadow: 0 24px 60px rgba(15,42,46,.3); }
.gs-dialog::backdrop { background: rgba(15,42,46,.55); }
.gs-dialog h2 { font-size: 1.15rem; margin: 0 0 8px; }
.gs-dialog p { color: var(--muted); font-size: .92rem; margin: 0 0 20px; }
.gs-dialog .row { display: flex; gap: 10px; justify-content: flex-end; }
.gs-btn.danger { background: var(--coral); border-color: var(--coral); color: #fff; }
.gs-btn.danger:hover { background: #c93a3f; }
.gs-toasts { position: fixed; right: 20px; bottom: 20px; display: grid; gap: 8px; z-index: 2000; }
.gs-toast { background: var(--ink); color: #fff; padding: 12px 16px; border-radius: 12px; font-size: .88rem; box-shadow: 0 10px 30px rgba(0,0,0,.25); animation: gsIn .25s ease; }
@keyframes gsIn { from { transform: translateY(10px); opacity: 0; } to { transform: none; opacity: 1; } }

@media (max-width: 1100px) {
  .gs-row { grid-template-columns: 1fr 1fr; gap: 12px 16px; }
  .gs-row.head { display: none; }
  .gs-row .gs-gauge { grid-column: 1 / -1; }
  .gs-row .gs-edit { grid-column: 1 / -1; }
  .gs-add-grid { grid-template-columns: 1fr 1fr; }
  .gs-add-grid .span2 { grid-column: 1 / -1; }
}
@media (prefers-reduced-motion: reduce) { .gs *, .gs-toast { transition: none !important; animation: none !important; } }
@media print {
  .gs-actions, .gs-add, .gs-tools, .gs-edit, .gs-del-wrap, .gs-legend, .gs-toasts { display: none !important; }
  .gs-row { grid-template-columns: 2fr 2fr 1fr 1fr; background: none !important; }
  .gs-overview { background: none; color: #000; border: 1px solid #000; }
}
</style>

<div class="gs">

  <div class="gs-head">
    <div>
      <h1>Manage Grocery</h1>
      <p>Track kitchen stock. Items at or below their alert limit show as low stock on the dashboard.</p>
    </div>
    <div class="gs-actions">
      <button type="button" class="gs-btn" id="gsExport">Export CSV</button>
      <button type="button" class="gs-btn" onclick="window.print()">Print</button>
      <button type="button" class="gs-btn primary" id="gsOpenAdd">Add item</button>
    </div>
  </div>

  <!-- overview -->
  <section class="gs-overview" aria-label="Stock overview">
    <div class="gs-ov-top">
      <span class="gs-ov-total num" id="ovTotal">0</span>
      <span class="gs-ov-label">items tracked</span>
    </div>
    <div class="gs-seg" role="img" aria-label="Share of healthy, low and out of stock items">
      <span class="s-ok" id="segOk" style="width:0"></span>
      <span class="s-low" id="segLow" style="width:0"></span>
      <span class="s-out" id="segOut" style="width:0"></span>
    </div>
    <div class="gs-legend">
      <button type="button" data-filter="all" class="active"><span class="gs-dot all"></span>All <b id="cAll">0</b></button>
      <button type="button" data-filter="ok"><span class="gs-dot ok"></span>Healthy <b id="cOk">0</b></button>
      <button type="button" data-filter="low"><span class="gs-dot low"></span>Low stock <b id="cLow">0</b></button>
      <button type="button" data-filter="out"><span class="gs-dot out"></span>Out of stock <b id="cOut">0</b></button>
    </div>
  </section>

  <!-- add item -->
  <section class="gs-add" id="gsAdd">
    <button type="button" class="gs-add-toggle" id="gsAddToggle" aria-expanded="false">
      <span>Add grocery item</span>
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="gs-add-body">
      <form method="post" action="{% url 'grocery_add' %}"> {# ADJUST: url name #}
        {% csrf_token %}
        <div class="gs-add-grid">
          <div class="span2"><label for="fName">Item name</label><input id="fName" class="gs-field" type="text" name="name" placeholder="e.g. Basmati rice" required></div>
          <div><label for="fQty">Quantity</label><input id="fQty" class="gs-field" type="number" name="quantity" min="0" step="0.01" value="0" required></div>
          <div><label for="fUnit">Unit</label>
            <select id="fUnit" class="gs-field" name="unit">
              <option value="kg">kg</option><option value="g">g</option><option value="l">l</option><option value="ml">ml</option><option value="pcs">pcs</option>
            </select>
          </div>
          <div><label for="fLimit">Alert limit</label><input id="fLimit" class="gs-field" type="number" name="alert_limit" min="0" step="0.01" value="5" required></div>
          <button class="gs-btn primary" type="submit" style="height:42px">Add item</button>
        </div>
      </form>
    </div>
  </section>

  <!-- stock list -->
  <section class="gs-list">
    <div class="gs-tools">
      <div class="gs-search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="gsSearch" class="gs-field" type="search" placeholder="Search item name" aria-label="Search item name">
      </div>
      <select id="gsSort" class="gs-field" style="width:auto" aria-label="Sort items">
        <option value="name-asc">Name A-Z</option>
        <option value="name-desc">Name Z-A</option>
        <option value="need">Needs attention first</option>
        <option value="qty-asc">Quantity: low to high</option>
        <option value="qty-desc">Quantity: high to low</option>
      </select>
      <span class="gs-count" id="gsCount"></span>
    </div>

    <div class="gs-row head" aria-hidden="true">
      <div>Item</div><div>Stock level (line = alert limit)</div><div>Alert limit</div><div>Status</div><div>Update quantity</div><div></div>
    </div>

    <div id="gsRows">
      {% for item in items %} {# ADJUST: context variable #}
      <div class="gs-row" data-name="{{ item.name|lower }}" data-qty="{{ item.quantity|stringformat:'f' }}" data-limit="{{ item.alert_limit|stringformat:'f' }}" data-unit="{{ item.unit }}">
        <div class="gs-name"><span class="n">{{ item.name }}</span></div>

        <div class="gs-gauge">
          <div class="gs-gauge-qty"><span class="q"></span> <small>{{ item.unit }}</small></div>
          <div class="gs-track"><div class="gs-fill"></div><div class="gs-tick" title="Alert limit"></div></div>
        </div>

        <div class="gs-limit"><span class="l"></span> {{ item.unit }}</div>
        <div><span class="gs-pill"></span></div>

        <form class="gs-edit" method="post" action="{% url 'grocery_update' item.pk %}"> {# ADJUST: url name #}
          {% csrf_token %}
          <div class="gs-step">
            <button type="button" data-step="-1" aria-label="Decrease">&minus;</button>
            <input type="number" name="quantity" step="0.01" min="0" value="{{ item.quantity|stringformat:'.2f' }}" aria-label="Quantity for {{ item.name }}">
            <button type="button" data-step="1" aria-label="Increase">+</button>
          </div>
          <button class="gs-save" type="submit" disabled>Save</button>
        </form>

        <div class="gs-del-wrap">
          <form method="post" action="{% url 'grocery_delete' item.pk %}" class="gs-del-form"> {# ADJUST: url name #}
            {% csrf_token %}
            <button class="gs-del" type="button" aria-label="Delete {{ item.name }}" title="Delete">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></svg>
            </button>
          </form>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="gs-empty" id="gsEmpty">
      <strong>No items match</strong>
      Try a different search, or clear the filter.
    </div>
  </section>
</div>

<dialog class="gs-dialog" id="gsDialog">
  <h2>Delete this item?</h2>
  <p id="gsDialogText">This removes the item from your stock list.</p>
  <div class="row">
    <button type="button" class="gs-btn" id="gsCancel">Cancel</button>
    <button type="button" class="gs-btn danger" id="gsConfirm">Delete</button>
  </div>
</dialog>

<div class="gs-toasts" id="gsToasts" aria-live="polite">
  {% for m in messages %}<div class="gs-toast">{{ m }}</div>{% endfor %}
</div>

<script>
(function () {
  var rowsBox = document.getElementById('gsRows');
  var rows = Array.prototype.slice.call(rowsBox.querySelectorAll('.gs-row'));
  var state = { filter: 'all', query: '', sort: 'name-asc' };

  function fmt(n) { return (Math.round(n * 100) / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function statusOf(qty, limit) { return qty <= 0 ? 'out' : (qty <= limit ? 'low' : 'ok'); }
  var LABEL = { ok: 'OK', low: 'Low stock', out: 'Out of stock' };

  function paint(row) {
    var qty = parseFloat(row.dataset.qty) || 0;
    var limit = parseFloat(row.dataset.limit) || 0;
    var st = statusOf(qty, limit);
    row.dataset.status = st;
    row.classList.remove('ok', 'low', 'out');
    row.classList.add(st);
    row.querySelector('.q').textContent = fmt(qty);
    row.querySelector('.l').textContent = fmt(limit);
    row.querySelector('.gs-pill').textContent = LABEL[st];
    var scale = Math.max(limit * 3, qty, 1);
    var pct = limit > 0 ? Math.min(100, (qty / (limit * 3)) * 100) : (qty > 0 ? 100 : 0);
    row.querySelector('.gs-fill').style.width = pct + '%';
  }

  function markDuplicates() {
    var seen = {};
    rows.forEach(function (r) { seen[r.dataset.name] = (seen[r.dataset.name] || 0) + 1; });
    rows.forEach(function (r) {
      var old = r.querySelector('.gs-dup');
      if (old) old.remove();
      if (seen[r.dataset.name] > 1) {
        var t = document.createElement('span');
        t.className = 'gs-dup';
        t.textContent = 'Duplicate name';
        r.querySelector('.gs-name').appendChild(t);
      }
    });
  }

  function overview() {
    var c = { ok: 0, low: 0, out: 0 };
    rows.forEach(function (r) { c[r.dataset.status]++; });
    var total = rows.length || 1;
    document.getElementById('ovTotal').textContent = rows.length;
    document.getElementById('cAll').textContent = rows.length;
    document.getElementById('cOk').textContent = c.ok;
    document.getElementById('cLow').textContent = c.low;
    document.getElementById('cOut').textContent = c.out;
    document.getElementById('segOk').style.width = (c.ok / total * 100) + '%';
    document.getElementById('segLow').style.width = (c.low / total * 100) + '%';
    document.getElementById('segOut').style.width = (c.out / total * 100) + '%';
  }

  function render() {
    var order = { out: 0, low: 1, ok: 2 };
    var list = rows.slice().sort(function (a, b) {
      var qa = parseFloat(a.dataset.qty), qb = parseFloat(b.dataset.qty);
      switch (state.sort) {
        case 'name-desc': return b.dataset.name.localeCompare(a.dataset.name);
        case 'need': return order[a.dataset.status] - order[b.dataset.status] || a.dataset.name.localeCompare(b.dataset.name);
        case 'qty-asc': return qa - qb;
        case 'qty-desc': return qb - qa;
        default: return a.dataset.name.localeCompare(b.dataset.name);
      }
    });
    var shown = 0;
    list.forEach(function (r) {
      var okFilter = state.filter === 'all' || r.dataset.status === state.filter;
      var okQuery = !state.query || r.dataset.name.indexOf(state.query) !== -1;
      var visible = okFilter && okQuery;
      r.style.display = visible ? '' : 'none';
      if (visible) shown++;
      rowsBox.appendChild(r);
    });
    document.getElementById('gsCount').textContent = 'Showing ' + shown + ' of ' + rows.length + ' items';
    document.getElementById('gsEmpty').classList.toggle('show', shown === 0);
  }

  function toast(msg) {
    var t = document.createElement('div');
    t.className = 'gs-toast';
    t.textContent = msg;
    document.getElementById('gsToasts').appendChild(t);
    setTimeout(function () { t.remove(); }, 3500);
  }
  document.querySelectorAll('.gs-toast').forEach(function (t) { setTimeout(function () { t.remove(); }, 4000); });

  rows.forEach(function (row) {
    paint(row);
    var input = row.querySelector('.gs-step input');
    var saveBtn = row.querySelector('.gs-save');
    var original = input.value;

    function dirtyCheck() {
      var dirty = input.value !== original && input.value !== '';
      row.classList.toggle('dirty', dirty);
      saveBtn.disabled = !dirty;
    }
    input.addEventListener('input', dirtyCheck);
    row.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = parseFloat(input.value) || 0;
        v = Math.max(0, v + parseFloat(b.dataset.step));
        input.value = (Math.round(v * 100) / 100).toFixed(2);
        dirtyCheck();
      });
    });

    var delBtn = row.querySelector('.gs-del');
    delBtn.addEventListener('click', function () {
      var dlg = document.getElementById('gsDialog');
      document.getElementById('gsDialogText').textContent = 'Delete "' + row.querySelector('.n').textContent + '" from your stock list? This cannot be undone.';
      dlg.showModal();
      document.getElementById('gsConfirm').onclick = function () { row.querySelector('.gs-del-form').submit(); };
    });
  });
  document.getElementById('gsCancel').addEventListener('click', function () { document.getElementById('gsDialog').close(); });

  document.querySelectorAll('[data-filter]').forEach(function (b) {
    b.addEventListener('click', function () {
      state.filter = b.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach(function (x) { x.classList.toggle('active', x === b); });
      render();
    });
  });
  document.getElementById('gsSearch').addEventListener('input', function (e) { state.query = e.target.value.trim().toLowerCase(); render(); });
  document.getElementById('gsSort').addEventListener('change', function (e) { state.sort = e.target.value; render(); });

  var addBox = document.getElementById('gsAdd');
  function toggleAdd(force) {
    var open = typeof force === 'boolean' ? force : !addBox.classList.contains('open');
    addBox.classList.toggle('open', open);
    document.getElementById('gsAddToggle').setAttribute('aria-expanded', open);
    if (open) { document.getElementById('fName').focus(); addBox.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  }
  document.getElementById('gsAddToggle').addEventListener('click', function () { toggleAdd(); });
  document.getElementById('gsOpenAdd').addEventListener('click', function () { toggleAdd(true); });

  document.getElementById('gsExport').addEventListener('click', function () {
    var lines = ['Item,In stock,Unit,Alert limit,Status'];
    rows.forEach(function (r) {
      var name = '"' + r.querySelector('.n').textContent.replace(/"/g, '""') + '"';
      lines.push([name, r.dataset.qty, r.dataset.unit, r.dataset.limit, LABEL[r.dataset.status]].join(','));
    });
    var blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'grocery-stock.csv';
    a.click();
    toast('CSV exported');
  });

  markDuplicates();
  overview();
  render();
})();
</script>
{% endblock %}