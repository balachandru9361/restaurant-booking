{% extends "base.html" %}
{% block content %}
<style>
  .admin-wrapper {
    display: flex;
    min-height: 100vh;
    font-family: 'Segoe UI', sans-serif;
    background: #f4f6f9;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
  }

  .admin-sidebar {
    width: 260px;
    background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 25px 18px;
    box-shadow: 4px 0 15px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .admin-sidebar h2 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 5px;
    letter-spacing: 0.5px;
  }

  .admin-sidebar .subtitle {
    font-size: 12px;
    color: #a0a0c0;
    margin-bottom: 25px;
  }

  .admin-user-card {
    background: rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .admin-user-card .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #F63A3A;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 16px;
  }

  .admin-user-card .info small {
    color: #a0a0c0;
    display: block;
    font-size: 11px;
  }

  .admin-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .admin-nav a {
    color: #d0d0e0;
    text-decoration: none;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 14.5px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
  }

  .admin-nav a:hover {
    background: rgba(246,58,58,0.15);
    color: #fff;
    transform: translateX(3px);
  }

  .admin-nav a.active {
    background: #F63A3A;
    color: #fff;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(246,58,58,0.4);
  }

  .admin-logout {
    margin-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 15px;
  }

  .admin-logout a {
    color: #ff8080;
    text-decoration: none;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 14.5px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
  }

  .admin-logout a:hover {
    background: rgba(255,80,80,0.15);
  }

  .admin-main {
    flex: 1;
    padding: 30px 35px;
    min-width: 0;
  }

  /* nav badge for unread admin notifications */
  .nav-badge {
    margin-left: auto;
    background: #F63A3A;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .nav-badge.show { display: inline-flex; animation: badgePop 0.4s ease; }
  @keyframes badgePop { 0% { transform: scale(0.4); } 70% { transform: scale(1.25); } 100% { transform: scale(1); } }

  /* highlight flash after jumping to Service Updates */
  .jump-flash { animation: jumpFlash 1.8s ease; border-radius: 12px; }
  @keyframes jumpFlash {
    0%   { box-shadow: 0 0 0 0 rgba(246,58,58,0.55); }
    60%  { box-shadow: 0 0 0 12px rgba(246,58,58,0); }
    100% { box-shadow: 0 0 0 0 rgba(246,58,58,0); }
  }

  /* live toast messages (server: order ready, admin: order served / out of stock, kitchen: stock arrived) */
  #liveToasts {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 340px;
  }
  .live-toast {
    background: #0d1b2a;
    color: #fff;
    border-left: 5px solid #d4af37;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 10px 28px rgba(0,0,0,0.3);
    animation: toastIn 0.35s ease;
  }
  .live-toast.alert { border-left-color: #F63A3A; }
  .live-toast.good { border-left-color: #2bb673; }
  .live-toast small { display: block; font-weight: 400; color: #a0a0c0; margin-top: 2px; }
  @keyframes toastIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
</style>

<div class="admin-wrapper">
  <nav class="admin-sidebar">
    <h2>🍽️ Restaurant Admin</h2>
    <div class="subtitle">Management Panel</div>

    <div class="admin-user-card">
      <div class="avatar">{{ request.user.username|slice:":1"|upper }}</div>
      <div class="info">
        {{ request.user.username }}
        <small>
          {% if request.user.is_superuser %}Administrator
          {% elif request.user.profile.role == 'server' %}Server
          {% else %}Chef{% endif %}
        </small>
      </div>
    </div>

    <div class="admin-nav">
      {% if request.user.is_superuser %}
        <a href="{% url 'dashboard:admin_home' %}" class="{% if request.resolver_match.url_name == 'admin_home' %}active{% endif %}">📊 Dashboard</a>
        <a href="{% url 'dashboard:admin_home' %}#serviceUpdates" id="navServiceUpdates">🔔 Service Updates <span class="nav-badge" id="notifBadge">0</span></a>
        <a href="{% url 'dashboard:manage_menu' %}" class="{% if request.resolver_match.url_name == 'manage_menu' %}active{% endif %}">🍽️ Manage Menu</a>
        <a href="{% url 'dashboard:manage_tables' %}" class="{% if request.resolver_match.url_name == 'manage_tables' %}active{% endif %}">🪑 Manage Tables</a>
        <a href="{% url 'dashboard:table_qr_codes' %}" class="{% if request.resolver_match.url_name == 'table_qr_codes' %}active{% endif %}">📱 QR Codes</a>
        <a href="{% url 'dashboard:manage_bookings' %}" class="{% if request.resolver_match.url_name == 'manage_bookings' %}active{% endif %}">📅 Manage Bookings</a>
        <a href="{% url 'dashboard:manage_users' %}" class="{% if request.resolver_match.url_name == 'manage_users' %}active{% endif %}">👥 Manage Users</a>
        <a href="{% url 'dashboard:add_staff' %}" class="{% if request.resolver_match.url_name == 'add_staff' %}active{% endif %}">➕ Add Staff Login</a>
        <a href="{% url 'dashboard:manage_orders' %}" class="{% if request.resolver_match.url_name == 'manage_orders' %}active{% endif %}">🧾 Manage Orders</a>
        <a href="{% url 'dashboard:manage_grocery' %}" class="{% if request.resolver_match.url_name == 'manage_grocery' %}active{% endif %}">🛒 Manage Grocery</a>
        <a href="{% url 'dashboard:kitchen_dashboard' %}" class="{% if request.resolver_match.url_name == 'kitchen_dashboard' %}active{% endif %}">👨‍🍳 Kitchen</a>
        <a href="{% url 'dashboard:kitchen_stock' %}" class="{% if request.resolver_match.url_name == 'kitchen_stock' %}active{% endif %}">🚫 Out of Stock</a>
        <a href="{% url 'dashboard:kitchen_stock_update' %}" class="{% if request.resolver_match.url_name == 'kitchen_stock_update' %}active{% endif %}">📦 Stock Update</a>
        <a href="{% url 'dashboard:server_dashboard' %}" class="{% if request.resolver_match.url_name == 'server_dashboard' %}active{% endif %}">🛎️ Server</a>
        <a href="{% url 'dashboard:sales_reports' %}" class="{% if request.resolver_match.url_name == 'sales_reports' %}active{% endif %}">📈 Sales / Reports</a>
      {% elif request.user.profile.role == 'server' %}
        <a href="{% url 'dashboard:server_dashboard' %}" class="{% if request.resolver_match.url_name == 'server_dashboard' %}active{% endif %}">🛎️ Server</a>
      {% else %}
        <a href="{% url 'dashboard:kitchen_dashboard' %}" class="{% if request.resolver_match.url_name == 'kitchen_dashboard' %}active{% endif %}">👨‍🍳 Kitchen</a>
        <a href="{% url 'dashboard:kitchen_stock' %}" class="{% if request.resolver_match.url_name == 'kitchen_stock' %}active{% endif %}">🚫 Out of Stock</a>
        <a href="{% url 'dashboard:kitchen_stock_update' %}" class="{% if request.resolver_match.url_name == 'kitchen_stock_update' %}active{% endif %}">📦 Stock Update</a>
      {% endif %}
    </div>

    <div class="admin-logout">
      <a href="{% url 'accounts:logout' %}">🚪 Logout</a>
    </div>
  </nav>

  <main class="admin-main">
    {% block admin_content %}{% endblock %}
  </main>
</div>

<div id="liveToasts"></div>

<script>
  // ---- shared helpers for live messages ----
  window.showToast = function (title, sub, kind) {
    const box = document.getElementById('liveToasts');
    const el = document.createElement('div');
    el.className = 'live-toast' + (kind ? ' ' + kind : '');
    el.innerHTML = title + (sub ? '<small>' + sub + '</small>' : '');
    box.appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .4s'; }, 7000);
    setTimeout(() => el.remove(), 7500);
  };

  window.beep = function () {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      [660, 880].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.frequency.value = freq;
        osc.connect(gain); gain.connect(ctx.destination);
        const t = ctx.currentTime + i * 0.18;
        gain.gain.setValueAtTime(0.15, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.16);
        osc.start(t); osc.stop(t + 0.16);
      });
    } catch (e) { /* browser blocked audio until first click - toast still shows */ }
  };

  // Re-fetch this page and swap only the #liveRegion block (no full reload)
  window.refreshLive = async function () {
    const el = document.getElementById('liveRegion');
    if (!el) return;
    try {
      const res = await fetch(location.href, { credentials: 'same-origin' });
      const html = await res.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.getElementById('liveRegion');
      if (fresh) el.innerHTML = fresh.innerHTML;
    } catch (e) { /* try again on next poll */ }
  };
</script>

{% if request.user.is_superuser %}
<script>
  // ---- Sidebar "Service Updates" -> scroll to the Service Updates section on the dashboard ----
  (function () {
    function findSection() {
      var el = document.getElementById('serviceUpdates');
      if (el) return el;
      // Fallback: find the heading that says "Service Updates" and use its card
      var heads = document.querySelectorAll('.admin-main h1, .admin-main h2, .admin-main h3, .admin-main h4, .admin-main h5');
      for (var i = 0; i < heads.length; i++) {
        if (heads[i].textContent.indexOf('Service Updates') !== -1) {
          return heads[i].parentElement || heads[i];
        }
      }
      return null;
    }

    function jump() {
      var el = findSection();
      if (!el) return false;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      el.classList.remove('jump-flash');
      void el.offsetWidth;
      el.classList.add('jump-flash');
      return true;
    }

    // Link clicked while already on the dashboard
    var link = document.getElementById('navServiceUpdates');
    if (link) {
      link.addEventListener('click', function (e) {
        if (link.pathname === location.pathname && findSection()) {
          e.preventDefault();
          jump();
          history.replaceState(null, '', link.pathname + '#serviceUpdates');
        }
      });
    }

    // Arrived from another page with #serviceUpdates in the URL
    if (location.hash === '#serviceUpdates') {
      window.addEventListener('load', function () { setTimeout(jump, 150); });
    }
  })();
</script>
{% endif %}

{% if not request.user.is_superuser and request.user.profile.role != 'server' %}
<script>
  // ---- Kitchen: live "admin restocked" notification ----
  (function () {
    const KEY = 'kitchenLastStockInId';

    function alertToast(title, text) {
      let stack = document.getElementById('kitchenAlertStack');
      if (!stack) {
        stack = document.createElement('div');
        stack.id = 'kitchenAlertStack';
        stack.style.cssText = 'position:fixed;top:18px;right:18px;z-index:10001;display:flex;flex-direction:column;gap:10px';
        document.body.appendChild(stack);
      }
      const t = document.createElement('div');
      t.style.cssText = 'min-width:290px;max-width:360px;padding:14px 16px;border-radius:14px;color:#fff;background:#0f766e;box-shadow:0 12px 30px rgba(0,0,0,.25);font-family:Inter,sans-serif';
      const b = document.createElement('b');
      b.style.cssText = 'display:block;font-size:14px;margin-bottom:2px';
      b.textContent = title;
      const s = document.createElement('small');
      s.style.cssText = 'font-size:12.5px;opacity:.95';
      s.textContent = text;
      t.appendChild(b);
      t.appendChild(s);
      stack.appendChild(t);
      setTimeout(function () { t.remove(); }, 6000);
    }

    function poll() {
      fetch("{% url 'dashboard:kitchen_notifications_poll' %}", { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          const stored = localStorage.getItem(KEY);
          if (stored === null) {
            localStorage.setItem(KEY, data.stock_in_id);   // first visit: no toast for old updates
            return;
          }
          if (data.stock_in_id > parseInt(stored, 10)) {
            localStorage.setItem(KEY, data.stock_in_id);
            alertToast('📦 Stock updated by admin', data.stock_in_message);
            if (typeof beep === 'function') beep();
          }
        })
        .catch(function () {});
    }
    poll();
    setInterval(poll, 8000);
  })();
</script>
{% endif %}

{% if request.user.is_superuser %}
<script>
  // ---- Admin: live "order served" / "out of stock" messages ----
  (function () {
    const KEY = 'lastSeenNotificationId';
    const badge = document.getElementById('notifBadge');

    function poll() {
      fetch("{% url 'dashboard:notifications_poll' %}", { credentials: 'same-origin' })
        .then(r => r.json())
        .then(data => {
          if (badge) {
            badge.textContent = data.unread;
            badge.classList.toggle('show', data.unread > 0);
          }
          const stored = localStorage.getItem(KEY);
          if (stored === null) {
            localStorage.setItem(KEY, data.latest_id);   // first visit: no toast for old messages
            return;
          }
          if (data.latest_id > parseInt(stored, 10)) {
            localStorage.setItem(KEY, data.latest_id);
            if (data.latest_kind === 'stock_in') return;   // admin's own restock: no toast

            // Title depends on what kind of notification it is
            let title = '🛎️ Order served';
            let tone = '';
            if (data.latest_kind === 'stock_out') {
              title = '🚫 Out of stock alert';
              tone = 'alert';
            } else if (data.latest_kind === 'stock') {
              title = '📋 Stock update';
            }
            showToast(title, data.latest_message, tone);

            beep();
            refreshLive();
          }
        })
        .catch(() => {});
    }
    poll();
    setInterval(poll, 8000);
  })();
</script>
{% endif %}
{% endblock %}