<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Store Management{% endblock %}</title>
<style>
  :root { --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --bg:#f5f6f8; --accent:#ff6b6b; --ok:#16a34a; --warn:#d97706; --bad:#dc2626; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--bg); color:var(--ink); }
  .layout { display:flex; min-height:100vh; }
  .side { width:220px; background:#111827; color:#fff; padding:22px 14px; position:sticky; top:0; height:100vh; flex-shrink:0; overflow-y:auto; }
  .side h2 { font-size:1.05rem; margin:0 0 22px 8px; }
  .side a, .side button.linklike { display:flex; align-items:center; gap:6px; width:100%; text-align:left; color:#cbd5e1; text-decoration:none; padding:10px 12px; border-radius:10px; font-size:.92rem; font-weight:600; margin-bottom:4px; background:none; border:none; cursor:pointer; font-family:inherit; }
  .side a:hover, .side button.linklike:hover { background:#1f2937; color:#fff; }
  .side a.active { background:var(--accent); color:#fff; }
  .side .sep { border-top:1px solid #1f2937; margin:12px 8px 10px; }
  .side .who { font-size:.78rem; color:#94a3b8; margin:18px 8px 8px; }
  .side .nav-badge { margin-left:auto; background:#dc2626; color:#fff; font-size:.7rem; font-weight:700; min-width:20px; height:20px; padding:0 6px; border-radius:10px; display:none; align-items:center; justify-content:center; }
  .side .nav-badge.show { display:inline-flex; }
  .main { flex:1; padding:28px; min-width:0; }
  h1 { font-size:1.5rem; margin:0 0 20px; }
  .card { background:#fff; border-radius:14px; box-shadow:0 2px 10px rgba(0,0,0,.05); padding:18px 20px; margin-bottom:20px; }
  .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:14px; margin-bottom:20px; }
  .stat { background:#fff; border-radius:14px; padding:16px 18px; box-shadow:0 2px 10px rgba(0,0,0,.05); }
  .stat .n { font-size:1.6rem; font-weight:800; }
  .stat .l { font-size:.78rem; color:var(--muted); font-weight:600; text-transform:uppercase; letter-spacing:.04em; }
  .stat.warn .n { color:var(--warn); } .stat.bad .n { color:var(--bad); }
  table { width:100%; border-collapse:collapse; font-size:.9rem; }
  th { text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); padding:10px 8px; border-bottom:1px solid var(--line); }
  td { padding:11px 8px; border-bottom:1px solid #f0f1f4; vertical-align:middle; }
  .table-wrap { overflow-x:auto; }
  .btn { display:inline-block; padding:8px 16px; border-radius:999px; border:none; font-weight:700; font-size:.85rem; cursor:pointer; text-decoration:none; background:#1f2937; color:#fff; font-family:inherit; }
  .btn:hover { background:var(--accent); }
  .btn.light { background:#fff; color:var(--ink); border:1.5px solid var(--ink); }
  .btn.light:hover { background:#f3f4f6; }
  .btn.small { padding:5px 12px; font-size:.78rem; }
  .btn.danger { background:#fff; color:var(--bad); border:1.5px solid var(--bad); }
  .btn.danger:hover { background:var(--bad); color:#fff; }
  .badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:.72rem; font-weight:700; }
  .badge.ok { background:#dcfce7; color:var(--ok); } .badge.low { background:#fef3c7; color:var(--warn); } .badge.out { background:#fee2e2; color:var(--bad); }
  .in { color:var(--ok); font-weight:700; } .outq { color:var(--bad); font-weight:700; }
  .toolbar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:16px; }
  input[type=text], input[type=number], input[type=password], select, textarea { padding:9px 12px; border:1px solid var(--line); border-radius:10px; font-size:.92rem; font-family:inherit; background:#fff; width:100%; }
  .toolbar input, .toolbar select { width:auto; }
  .field { margin-bottom:14px; } .field label { display:block; font-size:.78rem; font-weight:700; color:var(--muted); margin-bottom:5px; text-transform:uppercase; letter-spacing:.04em; }
  .errorlist { list-style:none; margin:4px 0 0; padding:0; color:var(--bad); font-size:.8rem; font-weight:600; }
  .help { font-size:.75rem; color:var(--muted); margin-top:4px; }
  .msg { padding:11px 16px; border-radius:10px; margin-bottom:14px; font-weight:600; font-size:.9rem; background:#dcfce7; color:#166534; }
  .msg.error { background:#fee2e2; color:#991b1b; }
  .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .muted { color:var(--muted); font-size:.85rem; }
  .radio-row { display:flex; gap:10px; flex-wrap:wrap; }
  .radio-row label { display:flex; align-items:center; gap:6px; padding:9px 14px; border:1.5px solid var(--line); border-radius:12px; cursor:pointer; font-size:.88rem; font-weight:600; color:var(--ink); text-transform:none; letter-spacing:0; margin:0; }
  .radio-row input { width:auto; }
  #storeToasts { position:fixed; top:18px; right:18px; z-index:10000; display:flex; flex-direction:column; gap:10px; max-width:340px; }
  .store-toast { background:#0d1b2a; color:#fff; border-left:5px solid #dc2626; border-radius:10px; padding:12px 16px; font-size:14px; font-weight:600; box-shadow:0 10px 28px rgba(0,0,0,.3); }
  .store-toast small { display:block; font-weight:400; color:#a0a0c0; margin-top:2px; }
  @media (max-width: 820px) {
    .layout { flex-direction:column; } .side { width:100%; height:auto; position:static; display:flex; flex-wrap:wrap; gap:4px; padding:12px; }
    .side h2, .side .who, .side .sep { display:none; } .side a, .side button.linklike { width:auto; } .main { padding:16px; } .grid2 { grid-template-columns:1fr; }
  }
</style>
</head>
<body>
<div class="layout">
  <nav class="side">
    <h2>🛒 Store Management</h2>
    <a href="{% url 'inventory:dashboard' %}" class="{% if request.resolver_match.url_name == 'dashboard' and request.resolver_match.namespace == 'inventory' %}active{% endif %}">📊 Dashboard</a>
    <a href="{% url 'inventory:item_list' %}" class="{% if request.resolver_match.url_name == 'item_list' %}active{% endif %}">🥬 Groceries & Stock</a>
    <a href="{% url 'inventory:item_add' %}" class="{% if request.resolver_match.url_name == 'item_add' %}active{% endif %}">➕ Add Item</a>
    <a href="{% url 'inventory:categories' %}" class="{% if request.resolver_match.url_name == 'categories' %}active{% endif %}">🏷️ Categories</a>
    <a href="{% url 'inventory:movements' %}" class="{% if request.resolver_match.url_name == 'movements' %}active{% endif %}">📜 Stock History</a>

    <div class="sep"></div>

    <a href="{% url 'dashboard:manage_grocery' %}" class="{% if request.resolver_match.url_name == 'manage_grocery' %}active{% endif %}">🛒 Manage Grocery</a>
    <a href="{% url 'dashboard:kitchen_stock' %}" class="{% if request.resolver_match.url_name == 'kitchen_stock' %}active{% endif %}">🚫 Out of Stock <span class="nav-badge" id="oosBadge">0</span></a>
    <a href="{% url 'dashboard:kitchen_stock_update' %}" class="{% if request.resolver_match.url_name == 'kitchen_stock_update' %}active{% endif %}">📦 Stock Update</a>

    <div class="who">Logged in as {{ request.user.username }}</div>
    <form method="post" action="{% url 'inventory:logout' %}">{% csrf_token %}<button class="linklike" type="submit">🚪 Logout</button></form>
  </nav>
  <main class="main">
    {% for m in messages %}<div class="msg {% if m.tags == 'error' %}error{% endif %}">{{ m }}</div>{% endfor %}
    {% block content %}{% endblock %}
    {% block admin_content %}{% endblock %}
  </main>
</div>

<div id="storeToasts"></div>

<script>
  // Kitchen -> Store live alerts: pending count badge + toast when kitchen reports an out-of-stock item
  (function () {
    var KEY = 'storeLastOutId';
    var badge = document.getElementById('oosBadge');
    var box = document.getElementById('storeToasts');

    function toast(title, text) {
      var el = document.createElement('div');
      el.className = 'store-toast';
      el.appendChild(document.createTextNode(title));
      var s = document.createElement('small');
      s.textContent = text;
      el.appendChild(s);
      box.appendChild(el);
      setTimeout(function () { el.remove(); }, 8000);
    }

    function store(key, val) { try { localStorage.setItem(key, val); } catch (e) {} }
    function load(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }

    function poll() {
      fetch("{% url 'dashboard:kitchen_notifications_poll' %}", { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (badge) {
            badge.textContent = d.pending;
            badge.classList.toggle('show', d.pending > 0);
          }
          var stored = load(KEY);
          if (stored === null) { store(KEY, d.stock_out_id); return; }
          if (d.stock_out_id > parseInt(stored, 10)) {
            store(KEY, d.stock_out_id);
            toast('🚫 Kitchen out-of-stock report', d.stock_out_message);
          }
        })
        .catch(function () {});
    }
    poll();
    setInterval(poll, 8000);
  })();
</script>
</body>
</html>
